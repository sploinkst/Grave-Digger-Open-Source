local p, equipment = player()
equal(Definitions.Selected(p), "Soldat", "new player default")
equal(#Definitions.Order, 7, "seven playable classes")
for _, name in Definitions.Order do
	local passive = Definitions.Get(name).Passive
	equal(type(passive), "string", name .. " has one combat experience name")
	equal(string.find(passive, "/", 1, true), nil, name .. " combat experience is not combined")
end
equal(Service.Select(p, "Admin"), false, "reject unknown class")
equal(Service.Select(p, {}), false, "reject malformed class")
equal(Service.Select(p, nil), false, "reject missing class")
equal(Service.Select(node("NotReady"), "Rook"), false, "reject selection without profile")
Service.ApplySpawn(p, p.Character)
equal(p.Character:GetAttribute("Class"), "Soldat", "spawn class")
equal(p.Character:GetAttribute("ClassPrimary"), "PrinceRifle", "primary snapshot")
equal(p.Character:GetAttribute("ClassSecondary"), "GraceRevolver", "Soldat can carry secondary")
equal(p.Character:GetAttribute("DrawSpeed"), 1.25, "Soldat draw bonus")
equal(p.Character:GetAttribute("AimSpeed"), 1.15, "Soldat aim bonus")
equal(p.Character:GetAttribute("SpreadMultiplier"), 0.9, "Soldat accuracy bonus")
equal(Service.Select(p, "Rook"), true, "select Rook")
equal(equipment.Secondary.Value, "", "remove overweight secondary")
equal(p.Character:GetAttribute("Class"), "Soldat", "selection cannot change live class")
equal(p.Character:GetAttribute("ClassSecondary"), "GraceRevolver", "selection cannot change live loadout")
equal(Service.Select(p, "Mortician"), false, "throttle class spam")
now += 1
equal(Service.Select(p, "Mortician"), true, "selection works after throttle")
local previousCharacter = p.Character
p.Character = node("Respawn", {}, "Model")
Service.ApplySpawn(p, p.Character)
equal(p.Character:GetAttribute("Class"), "Mortician", "selection applies at respawn")
equal(p.Character:GetAttribute("AllyHealHealth"), 200, "Mortician ally healing")
equal(p.Character:GetAttribute("DrawSpeed"), nil, "no Soldat bonus on medic")
previousCharacter:SetAttribute("Class", "old")
Service.ApplySpawn(p, previousCharacter)
equal(previousCharacter:GetAttribute("Class"), "old", "ignore stale characters")
for _, name in Definitions.Order do
	local user = player(name)
	Service.ApplySpawn(user, user.Character)
	equal(user.Character:GetAttribute("Class"), name, "spawn " .. name)
	table.clear(grants); table.clear(warnings)
	Service.GiveLoadout(user, user.Character)
	equal(includes(grants, "Medkit"), true, "common medical tool for " .. name)
	if name == "Soldat" then
		equal(user.Character:GetAttribute("Equipment"), "AmmoPack", "Soldat gets ammo pouch")
	elseif name == "Rook" then
		equal(includes(grants, "HeavyPickaxe"), true, "Rook gets heavy pick")
		equal(includes(grants, "Pickaxe"), false, "Rook does not get duplicate ordinary pick")
		equal(#warnings > 0, true, "missing controllers are reported")
	elseif name == "Lancer" then
		equal(user.Character:GetAttribute("ClassPrimary"), "HeavyLance", "Lancer fixed primary")
		equal(includes(grants, "PrinceRifle"), false, "Lancer cannot spawn firearm")
		equal(includes(grants, "GraceRevolver"), false, "Lancer cannot spawn pistol")
		equal(user.Character:GetAttribute("MeleeDamageMultiplier"), 0.7, "Lancer armor")
	elseif name == "Officer" then
		equal(user.Character:GetAttribute("CaptureWeight"), 2, "Officer capture contribution")
	elseif name == "Vanguard" then
		equal(user.Character:GetAttribute("SuppressionImmune"), true, "Vanguard suppression immunity")
	end
	if name ~= "Soldat" then equal(user.Character:GetAttribute("Equipment"), nil, "no borrowed ammo pouch for " .. name) end
end
local corrupt = player("Unknown", "HeavyGun", "GraceRevolver")
Service.ApplySpawn(corrupt, corrupt.Character)
equal(corrupt.Character:GetAttribute("Class"), "Soldat", "old invalid saves fall back")
equal(corrupt.Character:GetAttribute("ClassSecondary"), "", "spawn revalidates total weight")
local overweight = player("Rook", "HeavyGun", "GraceRevolver")
Service.ApplySpawn(overweight, overweight.Character)
equal(overweight.Character:GetAttribute("ClassPrimary"), "", "overweight primary rejected at spawn")
local once = player("Soldat")
table.clear(grants)
Service.GiveLoadout(once, once.Character)
equal(once.Character:GetAttribute("ClassSnapshotReady"), true, "equipment waits for class snapshot")
local grantCount = #grants
Service.GiveLoadout(once, once.Character)
equal(#grants, grantCount, "duplicate spawn notifications do not duplicate tools")
now += 1
Service.Select(once, "Officer")
Service.ApplySpawn(once, once.Character)
equal(once.Character:GetAttribute("Class"), "Soldat", "snapshot cannot be reapplied mid-life")
Datapush.start_module()
local push = storage.Shared.Library.Events.Datapush.OnServerEvent.callback
local user, slots = player()
push(user, {}, "Soldat")
equal(slots.Class.Value, "Soldat", "malformed request ignored")
push(user, "LoadoutPrimary", "GraceRevolver")
equal(slots.Primary.Value, "PrinceRifle", "reject pistol in primary slot")
push(user, "LoadoutPrimary", "UnknownGun")
equal(slots.Primary.Value, "PrinceRifle", "reject unknown weapon")
push(user, "LoadoutPrimary", "HeavyGun")
equal(slots.Primary.Value, "PrinceRifle", "reject total weight above capacity")
push(user, "LoadoutSecondary", "")
equal(slots.Secondary.Value, "", "clear slot")
push(user, "LoadoutPrimary", "HeavyGun")
equal(slots.Primary.Value, "HeavyGun", "accept valid heavier primary")
push(user, "LoadoutClass", "Rook")
equal(slots.Class.Value, "Rook", "class request accepted")
equal(slots.Primary.Value, "", "new class removes overweight primary")
push(user, "LoadoutPrimary", "HeavyGun")
equal(slots.Primary.Value, "", "server enforces Rook capacity")
local lancer, lancerSlots = player("Lancer", "", "")
push(lancer, "LoadoutPrimary", "PrinceRifle")
push(lancer, "LoadoutSecondary", "GraceRevolver")
equal(lancerSlots.Primary.Value, "", "Lancer primary cannot be changed to firearm")
equal(lancerSlots.Secondary.Value, "", "Lancer secondary firearm rejected")
print("Class system: " .. checks .. " checks passed")
