local officer = player(0, "A")
local ally = player(80, "A")
local enemy = player(0, "B")
issue(officer, "Advance", 30)
equal(officer.reply[1], "Accepted", "valid order")
tickAura()
equal(ally.Character:GetAttribute("OrderSpeedMultiplier"), 1.15, "80 stud boundary")
equal(enemy.Character:GetAttribute("OrderSpeedMultiplier"), 1, "exclude enemies")
equal(officer.Character:GetAttribute("OfficerOrderCharges"), 0, "consume charge")
issue(officer, "Defend", 30)
equal(officer.reply[1], "Rejected", "one order capacity")
ally.Character:FindFirstChild("HumanoidRootPart").Position = position(81)
tickAura()
equal(ally.Character:GetAttribute("OrderSpeedMultiplier"), 1, "remove outside range")
local second = player(0, "A", 2)
issue(second, "Advance", 60)
issue(second, "Focus", 30)
equal(second.reply[1], "Accepted", "Survivalist second order")
tickAura()
equal(officer.Character:GetAttribute("OrderSpeedMultiplier"), 1.15, "same order does not stack")
equal(officer.Character:GetAttribute("OrderFocusMultiplier"), 1.15, "different orders coexist")
local third = player(0, "A")
issue(third, "Defend", 30)
tickAura()
equal(officer.Character:GetAttribute("OrderFireRateMultiplier"), 1.15, "all three orders coexist")
equal(officer.Character:GetAttribute("OrderReloadMultiplier"), 1.15, "Defend reload bonus")
equal(officer.Character:GetAttribute("OrderRecoilMultiplier"), .8, "Focus recoil bonus")
issue(second, "Focus", 60)
equal(second.reply[1], "Rejected", "duplicate order rejected")
second.Character:FindFirstChildOfClass("Humanoid").Health = 0
tickAura()
equal(officer.Character:GetAttribute("OrderFocusMultiplier"), 1, "issuer death ends buff")
equal(second.Character:GetAttribute("OrderSpeedMultiplier"), 1, "dead recipient cleared")
now = 31
tickAura()
equal(officer.Character:GetAttribute("OfficerOrderCharges"), 1, "30 second recharge")
issue(officer, "Focus", 60)
officer.Character = character(0)
tickAura()
equal(officer.Character:GetAttribute("OrderFocusMultiplier"), 1, "no respawn inheritance")
issue(officer, "Defend", 60)
officer.Team = "B"
tickAura()
equal(officer.Character:GetAttribute("OrderFireRateMultiplier"), 1, "team change cancels order")
issue(officer, "Advance", 60)
now += 59
tickAura()
equal(officer.Character:GetAttribute("OfficerOrderCharges"), 0, "long order still active")
now += 1
tickAura()
equal(officer.Character:GetAttribute("OfficerOrderCharges"), 1, "60 second recharge")
print("Whistle behavior checks passed")
