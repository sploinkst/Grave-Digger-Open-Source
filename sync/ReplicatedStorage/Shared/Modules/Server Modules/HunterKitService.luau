local Players=game:GetService("Players"); local RS=game:GetService("ReplicatedStorage"); local Service={}; local status=require(script.Parent.StatusService)
local events=RS.Shared.Library.Events; local event=events:FindFirstChild("HunterKitAbility") or Instance.new("RemoteEvent"); event.Name="HunterKitAbility"; event.Parent=events
local trapsFolder=workspace:FindFirstChild("HunterTraps") or Instance.new("Folder"); trapsFolder.Name="HunterTraps"; trapsFolder.Parent=workspace
local function ownerOf(part) local id=part:GetAttribute("OwnerUserId"); return id and Players:GetPlayerByUserId(id) end
local function enemyFromPart(part,owner) local model=part and part:FindFirstAncestorOfClass("Model"); local p=model and Players:GetPlayerFromCharacter(model); if p and owner and p.Team~=owner.Team then return p end end
local function createTrap(player,kind)
	local c=player.Character; local r=c and c:FindFirstChild("HumanoidRootPart"); if not r or c:GetAttribute("Class")~="Jaeger" then return end
	local trap=Instance.new("Part"); trap.Name=kind; trap.Size=if kind=="Mantrap" then Vector3.new(3,.25,3) else Vector3.new(1,1,1); trap.Anchored=true; trap.CanCollide=false; trap.Material=Enum.Material.Metal; trap.Color=Color3.fromRGB(65,58,48); trap.CFrame=r.CFrame*CFrame.new(0,-2.5,-5); trap:SetAttribute("HunterTrap",true); trap:SetAttribute("OwnerUserId",player.UserId); trap:SetAttribute("TrapType",kind); trap.Parent=trapsFolder
	trap.Touched:Connect(function(hit) local target=enemyFromPart(hit,player); if not target or not trap.Parent then return end; if kind=="Mantrap" then status.GiveStatus(target,"CrippleStatus",3) elseif kind=="Light Lure" then status.GiveStatus(target,"LethalBurningStatus") else local h=target.Character and target.Character:FindFirstChildOfClass("Humanoid"); if h then h:TakeDamage(kind=="Shotshell Trap" and 80 or 50) end end; local manager=require(script.Parent.ReplicantManager); manager.SendPresentation(player,"trap_triggered",{message="Your "..kind.." was triggered."}); trap:Destroy() end)
	task.delay(90,function() if trap.Parent then trap:Destroy() end end)
end
function Service.TriggerHit(instance) local trap=instance; while trap and trap~=workspace and not trap:GetAttribute("HunterTrap") do trap=trap.Parent end; if not trap or not trap:IsA("BasePart") or not trap:GetAttribute("HunterTrap") then return false end; local owner=ownerOf(trap); local kind=trap:GetAttribute("TrapType"); local position=trap.Position; trap:Destroy(); for _,p in Players:GetPlayers() do local r=p.Character and p.Character:FindFirstChild("HumanoidRootPart"); local h=p.Character and p.Character:FindFirstChildOfClass("Humanoid"); if owner and p.Team~=owner.Team and r and h and (r.Position-position).Magnitude<=12 then h:TakeDamage(kind=="Dynamite Stack" and 100 or 45) end end; return true end
function Service.start_module() event.OnServerEvent:Connect(function(player,action,kind) if action=="PlaceTrap" and type(kind)=="string" then createTrap(player,kind) elseif action=="PlaceTripwire" then createTrap(player,"Tripwire") end end) end
return Service
